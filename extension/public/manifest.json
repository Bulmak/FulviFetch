{
  "manifest_version": 3,
  "name": "FulviFetch",
  "version": "0.4.0",
  "description": "Descarga experimental de audio público de YouTube, dentro de Firefox.",
  "permissions": [
    "downloads",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "activeTab",
    "menus"
  ],
  "commands": {
    "download-active-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Descargar el audio del video de la pestaña activa"
    }
  },
  "menus": {
    "context": [
      {
        "id": "download-link",
        "title": "FulviFetch: descargar el audio",
        "contexts": ["link"],
        "targetUrlPatterns": [
          "https://www.youtube.com/watch*",
          "https://youtube.com/watch*",
          "https://m.youtube.com/watch*",
          "https://music.youtube.com/watch*",
          "https://youtu.be/*",
          "https://www.youtube.com/shorts/*",
          "https://m.youtube.com/shorts/*"
        ]
      },
      {
        "id": "download-page",
        "title": "FulviFetch: descargar el audio de este video",
        "contexts": ["page"],
        "documentUrlPatterns": [
          "https://www.youtube.com/watch*",
          "https://youtube.com/watch*",
          "https://m.youtube.com/watch*",
          "https://music.youtube.com/watch*"
        ]
      }
    ]
  },
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtubei.googleapis.com/*",
    "https://*.googlevideo.com/*",
    "https://i.ytimg.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "action": {
    "default_title": "FulviFetch",
    "default_popup": "index.html",
    "default_icon": {
      "32": "icons/audio.svg",
      "48": "icons/audio.svg"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src 'none'; connect-src 'self' https://www.youtube.com https://youtubei.googleapis.com https://*.googlevideo.com https://i.ytimg.com"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fulvifetch@bulmak.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icons/audio.svg",
    "96": "icons/audio.svg"
  }
}
