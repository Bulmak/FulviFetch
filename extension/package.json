{
  "name": "fulvifetch",
  "version": "0.3.4",
  "private": true,
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && vite build && node scripts/notices.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "lint:extension": "web-ext lint --source-dir dist --warnings-as-errors",
    "package": "npm run build && web-ext build --source-dir dist --artifacts-dir artifacts --overwrite-dest"
  },
  "dependencies": {
    "mediabunny": "1.61.6",
    "youtubei.js": "18.2.0"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "143.0.1",
    "selenium-webdriver": "4.51.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "web-ext": "10.8.0"
  }
}
